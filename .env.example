# ── Bắt buộc ──
DISCORD_TOKEN=
DATABASE_URL=
PGSSL=true
# Đặt true (kèm PGSSL_CA nếu cần) để XÁC THỰC chứng chỉ PostgreSQL. Mặc định false để tương thích DB managed.
PGSSL_REJECT_UNAUTHORIZED=false
#PGSSL_CA=
# Chuỗi ngẫu nhiên DÀI (≥32 ký tự). Đổi giá trị này sẽ làm các API key đã lưu không giải mã được.
AI_SECRET_KEY=
# (tùy chọn) salt riêng cho scrypt. Nếu đặt thì phải giữ cố định, đổi = không giải mã được key đã lưu.
#AI_SECRET_SALT=

# ── Quản trị (ngoài quyền Administrator của Discord) ──
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=

# ── Tùy chọn ──
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=
PORT=10000
BOT_NAME=AI Council
USER_COOLDOWN_MS=4000        # giãn cách giữa 2 tin của cùng 1 người (admin được miễn)
COUNCIL_COOLDOWN_MS=12000    # giãn cách khi dùng @bot / reply (Hội đồng tốn quota hơn)
MAX_CONCURRENT_AI=4          # số yêu cầu AI chạy đồng thời
COUNCIL_MAX_MEMBERS=5        # số AI tối đa trong Hội đồng
HISTORY_SCOPE=user           # user = mỗi người một trí nhớ riêng trong kênh (khuyến nghị) | channel = dùng chung cả kênh
HISTORY_TURNS=8              # số lượt hỏi-đáp nhớ theo kênh (0 = tắt)
HISTORY_TTL_MS=1200000       # quên hội thoại sau 20 phút không hoạt động
IGNORE_PREFIXES=!,$          # bỏ qua tin bắt đầu bằng các tiền tố này (lệnh của bot khác)
