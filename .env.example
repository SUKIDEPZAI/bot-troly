# ===== Discord =====
DISCORD_TOKEN=
DISCORD_REPLY_ALL_MESSAGES=true
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_GUILD_IDS=
ALLOW_DMS=true
BOT_NAME=AI Council

# ===== PostgreSQL =====
DATABASE_URL=
PGSSL=true

# ===== AI providers =====
# A provider is enabled only when BOTH its API key and model are non-empty.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
XAI_API_KEY=
XAI_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
CUSTOM_AI_PROVIDERS_JSON=[]

# ===== OmniRoute =====
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# ===== Routing =====
EASY_THRESHOLD=30
MEDIUM_THRESHOLD=65
MAX_DEBATE_MODELS=4
DEBATE_MAX_CHARS_PER_AI=6500
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
MEMORY_MESSAGES=14
PROVIDER_COOLDOWN_MS=30000
MAX_PARALLEL_AI=4
HEADROOM_MIN_CHARS=1200

# ===== Headroom local SDK =====
HEADROOM_ENABLED=true
HEADROOM_FAIL_OPEN=true
HEADROOM_TOKEN_BUDGET=0

# ===== Web =====
WEB_ENABLED=true
WEB_PROVIDER=auto
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
SEARXNG_URL=
WEB_TIMEOUT_MS=30000
WEB_MAX_RESULTS=6
WEB_DEEP_MAX_RESULTS=10
WEB_CACHE_TTL_MS=300000

# ===== Image engine =====
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/txt2img_api.json
COMFYUI_CHECKPOINT=YOUR_CHECKPOINT.safetensors
IMAGE_TIMEOUT_MS=180000

# ===== Discord permissions =====
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
MODERATOR_ROLE_IDS=
REQUIRE_MENTION_FOR_NON_ADMINS=false
DISCORD_CLIENT_ID=

# ===== Environments =====
REASONING_ENV_ENABLED=true
REASONING_ENV_MAX_CHARS=3500
CRITIQUE_ENV_ENABLED=true
CRITIQUE_ENV_MAX_CHARS=4500
TEST_ENV_ENABLED=true
TEST_ENV_MAX_CHARS=4500

# ===== Professional ecosystem =====
PROFESSIONAL_MODE=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_MS=300000
SEMANTIC_CACHE_MAX_ENTRIES=500
MEMORY_STYLE=hybrid
EVAL_SAMPLING_RATE=0.15

PORT=10000
